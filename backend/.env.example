# ---------------------------------------------------------------------------
# CareerPilot-AI — Backend Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careerpilot

# Secret key used for signing JWTs (generate with: openssl rand -hex 32)
SECRET_KEY=change_me_to_a_long_random_secret

# CORS — comma-separated list of allowed origins for the frontend
CORS_ORIGINS=http://localhost:5173
